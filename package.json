{
	"name": "@jeftelabs/monitor-fs",
	"version": "1.0.0",
	"description": "File watcher for TypeScript projects",
	"main": "build/index.js",
	"type": "module",
	"files": [
		"build",
		"!build/bin",
		"!build/tests"
	],
	"exports": {
		".": "./build/index.js",
		"./types": "./build/src/types.js"
	},
	"engines": {
		"node": ">=18.16.0"
	},
	"scripts": {
		"pretest": "npm run lint",
		"test": "cross-env NODE_DEBUG=chokidar:ts c8 npm run quick:test",
		"lint": "eslint .",
		"format": "prettier --write .",
		"clean": "del-cli build",
		"typecheck": "tsc --noEmit",
		"precompile": "npm run lint && npm run clean",
		"compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
		"build": "npm run compile",
		"version": "npm run build",
		"prepublishOnly": "npm run build",
		"release": "release-it",
		"quick:test": "node --import=@jeftelabs/exec --enable-source-maps bin/test.ts",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "commit": "cz"
	},
	"devDependencies": {
		"@arapucajs/eslint-config": "^1.1.2",
		"@arapucajs/prettier": "^1.1.1",
		"@arapucajs/tsconfig": "^1.0.0",
		"@t8ngs/assert": "^1.0.0",
		"@t8ngs/fs": "^1.0.0",
		"@t8ngs/runner": "^1.0.0",
		"@jeftelabs/exec": "^1.0.1",
		"@types/node": "^22.15.21",
		"@types/picomatch": "^4.0.0",
		"c8": "^10.1.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
		"cross-env": "^7.0.3",
		"del-cli": "^6.0.0",
		"eslint": "^9.27.0",
		"prettier": "^3.5.3",
		"release-it": "^19.0.2",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"chokidar": "^4.0.3",
		"emittery": "^1.1.0",
		"memoize": "^10.1.0",
		"picomatch": "^4.0.2",
		"slash": "^5.1.0"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"homepage": "https://github.com/jeftelabs/monitor-fs#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeftelabs/monitor-fs.git"
	},
	"bugs": {
		"url": "https://github.com/jeftelabs/monitor-fs/issues"
	},
	"keywords": [
		"typescript",
		"tsc",
		"tsc-watch",
		"chokidar"
	],
	"author": "Jefte Costa <jefteamorim@gmail.com>",
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"tsup": {
		"entry": [
			"./index.ts",
			"./src/types.ts"
		],
		"outDir": "./build",
		"clean": true,
		"format": "esm",
		"dts": false,
		"sourcemap": false,
		"target": "esnext"
	},
	"c8": {
		"reporter": [
			"text",
			"html"
		],
		"exclude": [
			"tests/**"
		]
	},
	"prettier": "@arapucajs/prettier",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  }
}
